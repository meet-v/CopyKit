{
  "name": "obsidian-copykit",
  "version": "0.3.0",
  "private": true,
  "description": "Source project for an Obsidian copy and export toolkit plugin.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "html2canvas": "^1.4.1",
    "marked": "^15.0.12",
    "moment": "^2.31.0",
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "moment": "^2.31.0",
    "minimatch": "11.0.1"
  }
}
