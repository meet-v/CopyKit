{
  "name": "obsidian-copykit",
  "version": "0.2.0",
  "private": true,
  "description": "Source project for an Obsidian copy and export toolkit plugin.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "obsidian": "^1.13.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "marked": "^15.0.12"
  }
}
